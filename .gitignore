# --- delta-flink-playground ---------------------------------------------------

# Local environment / secrets (copy from .env.example -> .env)
.env

# Connector + storage jars staged into the Flink dist. These are big and are
# provisioned locally by `just assembly` (delta-flink fat jar) and
# `just bundle-jars` (AWS SDK bundle, guava, optional kafka connector).
flink/usrlib/*.jar

# Local filesystem tables written by the path-based demos (bind-mounted to the
# Flink containers at /opt/flink/data). Regenerated by the demos.
/data/
!/data/.gitkeep

# Rendered-at-runtime SQL (templated demos, e.g. UC endpoint/token injection).
sql/*.rendered.sql

# Python verifier virtualenv / caches
verify/.venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# OS cruft
.DS_Store

# --- generic Java (kept from the original template) ---------------------------
*.class
*.log
*.ctxt
.mtj.tmp/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*
