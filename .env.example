# Copy this file to .env and adjust as needed:
#
#   cp .env.example .env      (or run: just init)
#
# docker compose automatically loads .env from the project root, so any values
# set here are picked up when starting the containers. The Justfile also reads a
# few of these (DELTA_REPO, FLINK_BUILD_VERSION, MAVEN_PROXY_URL) at build time.

# --- Flink version -----------------------------------------------------------
# The Delta 4.4.0 delta-flink connector is experimental and built for the Flink
# 2.0 line (see https://github.com/delta-io/delta/issues/7351). We run it on the
# same image the connector's own docker setup uses.
#
#   FLINK_VERSION        -> docker image tag  (flink:${FLINK_VERSION})
#   FLINK_BUILD_VERSION  -> sbt -DflinkVersion (must be a supported spec:
#                           2.0.2 / 2.1.3 / 2.2.1 / 2.3.0). 2.0.2 is the 2.0-line
#                           build that pairs with the flink:2.0.1 runtime image.
FLINK_VERSION=2.0.1
FLINK_BUILD_VERSION=2.0.2

# Task slots per TaskManager (2 TMs are started -> 4 slots total by default).
FLINK_TASK_SLOTS=2

# --- Building the connector fat jar (just assembly) --------------------------
# Path to a local clone of https://github.com/delta-io/delta. `just assembly`
# runs `build/sbt -DflinkVersion=$FLINK_BUILD_VERSION flink/assembly` there and
# copies the resulting delta-flink-*.jar into flink/usrlib/. Relative paths are
# resolved from this repo's root.
DELTA_REPO=../../oss/delta-io/delta

# Maven proxy used for BOTH the sbt build and the `just bundle-jars` downloads.
# Java builds inherit $MAVEN_PROXY_URL from your shell if it is exported there
# (Delta's build/sbt consumes it automatically); this value is only used as a
# fallback when the shell variable is unset. Leave blank to use Maven Central.
#   Example (Databricks corp net): https://maven-proxy.cloud.databricks.com
MAVEN_PROXY_URL=

# --- Extra jars staged into flink/usrlib (just bundle-jars) ------------------
# The assembly excludes the AWS SDK bundle (must be supplied at runtime). These
# coordinates are downloaded from ${MAVEN_PROXY_URL:-Maven Central}.
AWS_SDK_BUNDLE_VERSION=2.23.19
GUAVA_VERSION=33.5.0-jre
# Optional: SQL Kafka connector for the upsert-kafka CDC demo (profile: kafka).
# Must match the Flink minor line. Downloaded only when you run the kafka demo.
FLINK_SQL_KAFKA_CONNECTOR=org.apache.flink:flink-sql-connector-kafka:4.0.1-2.0

# --- Unity Catalog (UC Delta API demo, sql/03) -------------------------------
# The UC demo reuses the OSS Unity Catalog server from the neighbouring
# unitycatalog-playground. By default we reach it (and its RustFS object store)
# over host.docker.internal using the ports that playground publishes. Start
# that playground first with `just uc=local start`.
UC_ENDPOINT=http://host.docker.internal:8080
UC_TOKEN=
UC_CATALOG=unity
UC_SCHEMA=flink_playground
UC_TABLE=clickstream

# --- S3 (ambient-credentials demo, sql/04) -----------------------------------
# Rendered into the Flink containers' core-site.xml (fs.s3a.endpoint / keys) for
# the S3 path-based demo. IMPORTANT: this experimental connector hardcodes
# fs.s3a.path.style.access=false in createEngine(), so custom-endpoint S3 stores
# (MinIO/RustFS) do NOT work via Flink SQL - only REAL AWS S3 (virtual-host).
# Leave blank for the local-FS demos (sql/01, sql/02), or set to a real S3
# endpoint + credentials to run sql/04. See README "Connector limitations".
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Redpanda (Kafka) for the upsert CDC demo (profile: kafka) ---------------
REDPANDA_KAFKA_PORT=9092
REDPANDA_ADMIN_PORT=9644
